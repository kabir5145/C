// Data types in C++

#include <iostream>

using namespace std;

int main(){
    cout << "Data types in C++:" << endl;
    cout << "1. int: Used for integers (whole numbers)." << endl;
    cout << "2. float: Used for single-precision floating-point numbers." << endl;
    cout << "3. double: Used for double-precision floating-point numbers." << endl;
    cout << "4. char: Used for single characters." << endl;
    return 0;
}